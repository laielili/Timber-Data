# Frontend environment (no secrets — synthetic prototype).

# Data source mode for the frontend data layer:
#   api  -> FastAPI analytics service (Backend Phase 01) — primary integrated mode
#   mock -> local /data/*.json (offline demo / regression)
VITE_DATA_SOURCE=api

# Base URL of the FastAPI data service.
VITE_API_BASE_URL=http://localhost:8000

# Ask Circular analyst mode (Phase 02):
#   real -> free-text questions sent to POST /api/v1/analyst/query (needs AI_ENABLED backend)
#   mock -> deterministic prototype Q&A (no AI connection)
VITE_ANALYST_MODE=mock
