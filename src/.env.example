# Backend AI Analyst (Phase 02 + Provider Settings) — environment configuration.
# ALL credentials come from the environment OR the local settings store. Never commit
# real values. The frontend never receives AI_API_KEY; model calls happen server-side.

# ---------------------------------------------------------------------------
# Configuration priority (single policy, see AI_PROVIDER_SETTINGS.md):
#   saved local settings (backend/.secrets/ai_provider.json)
#     -> environment variables (below)
#       -> safe defaults
# The local UI (AI Provider Settings drawer) writes backend/.secrets/ai_provider.json,
# which takes priority over these env vars. Environment variables remain useful for
# deployment / containerised setups.
# ---------------------------------------------------------------------------

# Master switch for the conversational analyst endpoint.
#   true  -> POST /api/v1/analyst/query is live (requires a valid provider + key)
#   false -> endpoint returns a clean "ai_disabled" error (dashboard still works)
AI_ENABLED=false

# Provider type. Currently supported: openai-compatible.
AI_PROVIDER=openai-compatible

# Model id for the chosen provider (e.g. gpt-4o-mini, gpt-4o).
AI_MODEL=

# API key — server-side only. Leave empty unless AI_ENABLED=true.
# Prefer configuring this via the in-app AI Provider Settings drawer, which stores it
# in backend/.secrets/ai_provider.json (git-ignored, file perms 600).
AI_API_KEY=

# Base URL of an OpenAI-compatible chat-completions endpoint.
# OpenAI:        https://api.openai.com/v1
# OpenRouter:    https://openrouter.ai/api/v1
# Local server:  http://localhost:11434/v1  (Ollama) etc.
AI_BASE_URL=https://api.openai.com/v1

# Guardrails.
AI_MAX_TOOL_ROUNDS=6
AI_MAX_QUESTION_LEN=2000
AI_MAX_HISTORY=12
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT=60
